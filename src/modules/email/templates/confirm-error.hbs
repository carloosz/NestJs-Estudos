<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Erro ao confirmar</title>
</head>
<body style="margin:0; padding:0; background-color:#0d0b14; font-family: Arial, Helvetica, sans-serif; height:100vh;">
  <table role="presentation" width="100%" height="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" valign="middle">
        <table role="presentation" width="420" cellpadding="0" cellspacing="0" style="background-color:#1a1625; border-radius: 16px; overflow:hidden; text-align:center;">
          <tr>
            <td style="padding: 40px 32px;">
              <div style="width:56px; height:56px; border-radius:50%; background:#3a2035; margin: 0 auto 20px auto; line-height:56px; color:#f87171; font-size:26px;">
                ✕
              </div>
              <h1 style="margin:0 0 12px 0; color:#ffffff; font-size: 20px;">Não foi possível confirmar</h1>
              <p style="margin:0 0 28px 0; color:#a89fc2; font-size: 14px; line-height: 20px;">
                {{message}}
              </p>
              <a href="{{loginUrl}}"
                 style="display:inline-block; padding: 12px 28px; font-size: 14px; font-weight:700; color:#e5e0f0; text-decoration:none; border-radius: 10px; border: 1px solid #3a3050;">
                Voltar para o login
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
